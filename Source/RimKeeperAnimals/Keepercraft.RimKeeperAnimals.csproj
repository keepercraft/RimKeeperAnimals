<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
	<AssemblyTitle>RimKeeperAnimals</AssemblyTitle>
	<Authors>Keepercraft</Authors>
    <AssemblyName>$(Authors).$(AssemblyTitle)</AssemblyName>
	<AssemblyVersion>$(Version)</AssemblyVersion>
	<AssemblyProduct>$(AssemblyName)</AssemblyProduct>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Copyright>Copyright © 2024 Keepercraft</Copyright>
    <Version>$(Configuration).1.6</Version>
	<AssemblyVersion>$(Version)</AssemblyVersion>
	<FileVersion>$(Version)</FileVersion>
    <Title>$(AssemblyName)</Title>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
	<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <IncludeSymbols>True</IncludeSymbols>
	<GenerateAssemblyInfo>True</GenerateAssemblyInfo>
	<Platforms>x64;x64 debug</Platforms>
	<Configurations>1.7;1.6;1.5</Configurations>
	<LangVersion>14</LangVersion>
	<DebugType>none</DebugType>
	<DebugSymbols>false</DebugSymbols>
	<GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Platform)' == 'x64' Or '$(Platform)' == 'x64 debug'">
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<BaseOutputPath />
		<OutputPath>..\..\$(Configuration)\Assemblies</OutputPath>
		<ModCopyDir>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\Mods\$(AssemblyTitle)\</ModCopyDir>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Platform)' == 'x64 debug'">
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>

	<Target Name="PrepareFiles" BeforeTargets="PrepareForBuild">
		<RemoveDir Directories="$(OutputPath)" />
		<RemoveDir Directories="$(ModCopyDir)\$(Configuration)\Assemblies" />
	</Target>	
	<Target Name="CopyModFiles" AfterTargets="Build">
		<ItemGroup>
			<SFiles Include="..\..\README.md;..\..\LICENSE" />
			<DllFiles Include="$(OutputPath)**\*.*" />
			<AboutFiles Include="..\..\About\**\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(SFiles)" DestinationFolder="$(ModCopyDir)\%(RecursiveDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(DllFiles)" DestinationFolder="$(ModCopyDir)\$(Configuration)\Assemblies\%(DllFiles.RecursiveDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(AboutFiles)" DestinationFolder="$(ModCopyDir)\About\%(AboutFiles.RecursiveDir)" SkipUnchangedFiles="true" />
	</Target>

    <ItemGroup>
        <None Include="..\..\LICENSE">
          <Pack>True</Pack>
          <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

	<PropertyGroup Condition="'$(Configuration)' == '1.5'">
		<DefineConstants>$(DefineConstants);RIMWORLD_15</DefineConstants>
		<TargetFramework>net472</TargetFramework>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == '1.6'">
		<DefineConstants>$(DefineConstants);RIMWORLD_16</DefineConstants>
		<TargetFramework>net472</TargetFramework>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == '1.7'">
		<DefineConstants>$(DefineConstants);RWRIMWORLD_17</DefineConstants>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>
	
	<ItemGroup Condition="'$(Configuration)' == '1.5'">
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.5.4085" ExcludeAssets="runtime" />
		<PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
	</ItemGroup>
	
	<ItemGroup Condition="'$(Configuration)' == '1.6'">
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" ExcludeAssets="runtime" />
		<PackageReference Include="Lib.Harmony" Version="2.3.6" ExcludeAssets="runtime" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == '1.7'">
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4977-alpha.1" ExcludeAssets="runtime" />
		<PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" ExcludeAssets="runtime" />
	</ItemGroup>

</Project>
